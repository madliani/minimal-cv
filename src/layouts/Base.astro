---
import config from '@/config'
import { ViewTransitions } from 'astro:transitions'

import BaseHead from '@/components/BaseHead.astro'

import FooterNavbar from '@/components/FooterNavbar.astro'
import HeaderNavbar from '@/components/HeaderNavbar.astro'
import '@fortawesome/fontawesome-free/css/all.css'
import 'bulma/css/versions/bulma-prefixed.css'

type Props = {
  meta?: {
    title?: string
    description?: string
  }
}

const { meta = {} } = Astro.props
const { title = config.title, description = config.description } = meta
---

<html lang={config.lang}>
  <head>
    <BaseHead title={title} description={description} />
    <ViewTransitions />
  </head>
  <body>
    <main class="bulma-section">
      <!-- Header with navigation bar -->
      <header class="bulma-container">
        <HeaderNavbar />
      </header>

      <!-- Content -->
      <section class="bulma-container">
        <slot />
      </section>

      <!-- Footer with navigation bar -->
      <footer class="bulma-container">
        <FooterNavbar />
      </footer>
    </main>
  </body>
</html>
