---
import "@fortawesome/fontawesome-free/css/all.css"
import FooterNavbar from "@src/components/FooterNavbar.astro"
import HeaderNavbar from "@src/components/HeaderNavbar.astro"
import Metadata from "@src/components/Metadata.astro"
import config from "@src/config"
import { ClientRouter } from "astro:transitions"
import "bulma/css/versions/bulma-prefixed.css"

interface Props {
    meta?: { description?: string; title?: string }
}

const { meta = {} } = Astro.props
const { description = config.description, title = config.title } = meta
---

<html lang={config.lang}>
    <head>
        <Metadata description={description} title={title} />

        <ClientRouter />
    </head>

    <body>
        <main class="bulma-section">
            <!-- Header with navigation bar -->
            <header class="bulma-container">
                <HeaderNavbar />
            </header>

            <!-- Content -->
            <section class="bulma-container">
                <slot />
            </section>

            <!-- Footer with navigation bar -->
            <footer class="bulma-container">
                <FooterNavbar />
            </footer>
        </main>
    </body>
</html>
