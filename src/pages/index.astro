---
import EduCard from '@/components/EduCard.astro'
import ExpCard from '@/components/ExpCard.astro'
import ResumeDlButton from '@/components/ResumeDlButton.astro'
import SummaryColumns from '@/components/SummaryColumns.astro'
import Base from '@/layouts/Base.astro'
---

<Base meta={{ title: 'Home' }}>
  <div class="bulma-container">
    <!-- Summary with photo -->
    <div class="bulma-section">
      <SummaryColumns />
    </div>

    <!-- Experience -->
    <section class="bulma-section">
      <ExpCard />
    </section>

    <!-- Education -->
    <section class="bulma-section">
      <EduCard />
    </section>

    <!-- Resume download -->
    <div class="bulma-section"><ResumeDlButton /></div>
  </div>
</Base>
